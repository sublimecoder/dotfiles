#!/bin/sh

# Kills every process listening on the provided port
#
# clear-port 3000

if [ -z "$1" ]; then
  echo >&2 Usage: clear-port port-number
  exit 1
fi

pids="$(lsof -ti4TCP:"$1")"
if [ -z "$pids" ]; then
  echo "nothing listening on port $1"
  exit 1
fi

# Piped through xargs so multiple listeners on one port all die.
echo "$pids" | xargs kill -9
