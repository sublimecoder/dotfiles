# Shared zshrc — everything true on BOTH machines.
#
# Anything OS-specific lives in macos/zsh/configs/ or linux/zsh/configs/ and is
# linked into ~/.zsh/configs/ by install.sh, where the loader below already picks
# it up. There is deliberately no `if [ "$(uname)" = Darwin ]` in this file: the
# split is done by which files get linked, not by branching at runtime.

# load custom executable functions
for function in ~/.zsh/functions/*; do
  source $function
done

# extra files in ~/.zsh/configs/pre , ~/.zsh/configs , and ~/.zsh/configs/post
# these are loaded first, second, and third, respectively.
_load_settings() {
  _dir="$1"
  if [ -d "$_dir" ]; then
    if [ -d "$_dir/pre" ]; then
      for config in "$_dir"/pre/**/*~*.zwc(N-.); do
        . $config
      done
    fi

    for config in "$_dir"/**/*(N-.); do
      case "$config" in
        "$_dir"/(pre|post)/*|*.zwc)
          :
          ;;
        *)
          . $config
          ;;
      esac
    done

    if [ -d "$_dir/post" ]; then
      for config in "$_dir"/post/**/*~*.zwc(N-.); do
        . $config
      done
    fi
  fi
}
_load_settings "$HOME/.zsh/configs"

alias vim='MIX_ENV=test nvim'
alias vi='MIX_ENV=test nvim'
alias v='MIX_ENV=test nvim'

export PATH="$HOME/.bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# Guarded because this file is now sourced on a machine that may not have them.
# Unguarded, `direnv hook zsh` on a box without direnv prints an error on EVERY
# new shell, and `$(go env GOPATH)` without go puts an empty element on PATH.
command -v direnv >/dev/null && eval "$(direnv hook zsh)"
command -v go >/dev/null && export PATH="$PATH:$(go env GOPATH)/bin"

# aliases
[[ -f ~/.aliases ]] && source ~/.aliases

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# bun. Was an absolute /Users/jsmith path; $BUN_INSTALL is the same value and
# resolves on both machines.
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"
