" Plain-vim fallback. nvim (LazyVim, shared/config/nvim/) is the editor; this
" file needs no plugins, so `vim` still opens usable on a box with nothing
" installed. The old vim-plug/ALE setup is in git history (vimrc.bundles).
set nocompatible encoding=utf-8
let mapleader = " "

set backspace=2
set nobackup nowritebackup noswapfile
set ruler showcmd incsearch hlsearch ignorecase smartcase
set laststatus=2
set autowrite
set nomodeline modelines=0
set termguicolors background=dark
set number relativenumber numberwidth=5
set textwidth=80 colorcolumn=+1
set tabstop=2 shiftwidth=2 shiftround expandtab autoindent copyindent
set list listchars=tab:»·,trail:·,nbsp:·
set nojoinspaces
set splitbelow splitright
set diffopt+=vertical
set wildmode=list:longest,list:full
set spellfile=$HOME/.vim-spell-en.utf-8.add
set complete+=kspell
set noerrorbells visualbell t_vb=
let g:is_posix = 1

syntax on
filetype plugin indent on

augroup vimrcEx
  autocmd!
  " Jump to the last known cursor position, except in commit messages.
  autocmd BufReadPost *
    \ if &ft != 'gitcommit' && line("'\"") > 0 && line("'\"") <= line("$") |
    \   exe "normal g`\"" |
    \ endif
  autocmd BufRead,BufNewFile aliases,zshenv,zlogin,zlogout,zshrc,zprofile,*/zsh/configs/* set filetype=sh
  autocmd BufRead,BufNewFile *.ex,*.exs,mix.lock set filetype=elixir
  autocmd BufRead,BufNewFile *.eex,*.heex,*.leex set filetype=eelixir
  autocmd BufWritePre * :%s/\s\+$//e
augroup END

if executable('rg')
  set grepprg=rg\ --vimgrep\ --no-heading\ --smart-case
endif
nnoremap K :grep! "\b<C-R><C-W>\b"<CR>:cw<CR>

nnoremap <Leader><Leader> <C-^>
nnoremap <Leader>h :nohlsearch<CR>
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-h> <C-w>h
nnoremap <C-l> <C-w>l

" Dot command and macros over a visual selection.
xnoremap . :normal .<CR>
xnoremap @ :<C-u>execute ":'<,'>normal @".nr2char(getchar())<CR>
