# Shell-neutral core, sourced by BOTH bash and zsh.
#
# WHY THIS FILE EXISTS. The Mac runs zsh and Omarchy runs bash (see
# docs/shell-decision.md), and for a while that meant this repo's tooling reached
# only one of them. It did not have to: `g` -- 1100 invocations, the most-used
# thing here -- is `if [[ $# -gt 0 ]]; then git "$@"; else git status; fi`, which
# is as valid in bash as in zsh. 59 of 63 aliases are likewise portable.
#
# So the split is not zsh-vs-bash, it is PORTABLE-vs-NOT. This file is the
# portable half. zsh-only things stay in ~/.zsh/ and are loaded by zshrc alone.
#
# Sourced from shared/zshrc, and from ~/.bashrc via one appended line -- appended
# rather than symlinked because ~/.bashrc is a real file on Omarchy carrying
# machine-local content (cargo, gcloud) that must not be clobbered.

# Which shell is this? Needed for the hook helpers below, which take the name.
if [ -n "$ZSH_VERSION" ]; then
  _shell_name=zsh
elif [ -n "$BASH_VERSION" ]; then
  _shell_name=bash
else
  _shell_name=sh
fi

# Portable functions: g, mcd, envup. Guarded because the directory does not
# exist until install.sh has run, and an unmatched glob is an ERROR in zsh
# rather than a silent no-op.
if [ -d "$HOME/.shell/functions" ]; then
  for _f in "$HOME"/.shell/functions/*; do
    [ -f "$_f" ] && . "$_f"
  done
  unset _f
fi

[ -f "$HOME/.aliases" ] && . "$HOME/.aliases"

export PATH="$HOME/.bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# Guarded: unguarded, `direnv hook` prints an error on EVERY new shell on a box
# without direnv, and `$(go env GOPATH)` with no go appends an empty PATH element.
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook $_shell_name)"
fi
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate $_shell_name)"
fi
if command -v go >/dev/null 2>&1; then
  export PATH="$PATH:$(go env GOPATH)/bin"
fi

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && . "$BUN_INSTALL/_bun"

[ -f "$HOME/.fzf.$_shell_name" ] && . "$HOME/.fzf.$_shell_name"

# systemd's ssh-agent.service (Omarchy) does NOT export this itself -- its own
# unit file says so. A graphical login gets it from elsewhere; a shell spawned
# by an agent harness does not, so the key sits unlocked in a running agent the
# shell cannot see and every signed commit dies on ssh_askpass. Guarded twice:
# only when nothing already set it (ssh -A forwarding wins), and only when the
# socket is really there -- on the Mac launchd sets its own path and this is a
# no-op.
_agent_sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-agent.socket"
if [ -z "${SSH_AUTH_SOCK:-}" ] && [ -S "$_agent_sock" ]; then
  export SSH_AUTH_SOCK="$_agent_sock"
fi
unset _agent_sock

unset _shell_name

# Bash prompt. Omarchy's stock PS1 is '[\u@\h \W]\$ ' -- no color, no branch,
# and the host name is noise on the box you are sitting at. This mirrors the zsh
# prompt (shared/zsh/configs/prompt.zsh): bold blue dir, bold green branch,
# user@host only when SSH'd in. \[ \] around every escape, or bash miscounts the
# line width and long commands wrap on top of themselves.
if [ -n "$BASH_VERSION" ] && ! env | grep -q '^PS1='; then
  _git_branch() {
    local b
    b=$(git symbolic-ref --short HEAD 2>/dev/null) || return
    printf ' \001\e[1;32m\002%s\001\e[0m\002' "$b"
  }
  PS1='\[\e[1;34m\]\W\[\e[0m\]$(_git_branch) \$ '
  [ -n "$SSH_CONNECTION" ] && PS1='\[\e[1;32m\]\u@\h\[\e[0m\]:'"$PS1"
fi
