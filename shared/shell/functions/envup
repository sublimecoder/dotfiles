# Load .env file into shell session for environment variables.
#
# Parsed, not sourced: `. .env` would run any command a cloned repo's .env
# carries, and the old `export $(sed ...)` split values on spaces and globbed
# them. Handles KEY=value, `export KEY=value`, and one layer of '' or "" quotes.
#
# Parsing alone is not enough: some variables are run by the shell or by tools
# (PROMPT_COMMAND at every prompt, LD_PRELOAD in every binary, PATH picking which
# `git` runs). Those names are refused with a warning; export them by hand if
# you mean it. shortcut: denylist, not exhaustive; switch to an allowlist if
# envup is ever run on untrusted repos as a habit.
envup() {
  if [ ! -f .env ]; then
    echo 'No .env file found' 1>&2
    return 1
  fi
  local line key val
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"   # leading whitespace
    case "$line" in '#'*|'') continue ;; esac
    case "$line" in *=*) ;; *) continue ;; esac
    line="${line#export }"
    key="${line%%=*}"
    val="${line#*=}"
    case "$key" in
      # Uppercase only: zsh ties lowercase path/fpath/cdpath/manpath to the
      # uppercase ones, so `path=...` would walk straight past the list below.
      ''|[0-9]*|*[!A-Z0-9_]*) echo "envup: skip (not an UPPER_CASE name): $key" 1>&2; continue ;;
      PATH|FPATH|CDPATH|MANPATH|IFS|ENV|BASH_ENV|ZDOTDIR|SHELLOPTS|BASHOPTS|HOME| \
      PROMPT_COMMAND|PS[0-4]|PROMPT|RPROMPT|RPS[12]|HISTFILE|TMPDIR|TERMINFO|XDG_*| \
      LD_*|DYLD_*|GIT_*|*_COMMAND|*ASKPASS|EDITOR|VISUAL|PAGER|MANPAGER|BROWSER| \
      LESSOPEN|LESSCLOSE|NODE_OPTIONS|NODE_PATH|PERL5OPT|PERL5LIB|PYTHONSTARTUP| \
      PYTHONPATH|RUBYOPT|RUBYLIB|JAVA_TOOL_OPTIONS)
        echo "envup: refused (shell or tools would run it): $key" 1>&2; continue ;;
    esac
    case "$val" in
      \"*\") val="${val#\"}"; val="${val%\"}" ;;
      \'*\') val="${val#\'}"; val="${val%\'}" ;;
    esac
    export "$key=$val"
  done < .env
}
